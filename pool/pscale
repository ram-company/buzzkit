#!/bin/bash
# pscale as Pool's service token, never the global login: `pool/run pool/pscale database list`.
# --org goes on resource subcommands only, so pass it where the command takes it.
set -euo pipefail
: "${PLANETSCALE_SERVICE_TOKEN_ID:?}" "${PLANETSCALE_SERVICE_TOKEN:?}"
exec pscale --service-token-id "$PLANETSCALE_SERVICE_TOKEN_ID" \
  --service-token "$PLANETSCALE_SERVICE_TOKEN" "$@"
