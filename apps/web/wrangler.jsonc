{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pool-buzzkit-web",
  "account_id": "5f4ee34fe9caef1d02a43fa2af4e5a67",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "routes": [{ "pattern": "push.pool.day", "custom_domain": true }],

  // Pool: no marketing Worker. The dashboard only hands buzzkit.dev's own paths to it
  // (workers/app.ts), and this deployment never serves that host.

  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    "ENVIRONMENT": "production",
    "API_URL": "https://push-api.pool.day"
  }
}
