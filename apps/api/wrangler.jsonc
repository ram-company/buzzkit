{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pool-buzzkit-api",
  "account_id": "5f4ee34fe9caef1d02a43fa2af4e5a67",
  "routes": [{ "pattern": "push-api.pool.day", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // Pool: no workers.dev or preview URLs. A preview shares every production binding, so a send
  // issued from one reaches real devices; the only entry point is push-api.pool.day.
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    "ENVIRONMENT": "production",
    "WORKFLOW_TIME_SCALE": "1",
    "DASHBOARD_URL": "https://push.pool.day",
    "BETTER_AUTH_URL": "https://push-api.pool.day/v1/auth",
    "TRACE_SAMPLE_RATIO": "1",
    "TINYBIRD_URL": "https://api.us-east.aws.tinybird.co"
  },

  // Pool: no Email Sending binding. Invite email fails cleanly (libs/email.ts); a teammate signs
  // up while the sign-up WAF rule is lifted (pool/README.md).

  // Remote resources are always named `pool-buzzkit-<what it holds>`, never after the binding:
  // the Hyperdrive config is `pool-buzzkit-postgres`. A config only carries the id, so the name
  // lives in Cloudflare; rename with `wrangler hyperdrive update <id> --name` or
  // `wrangler kv namespace rename`, neither of which changes the id.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "PROVISION:pool-buzzkit-postgres",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5460/buzzkit"
    }
  ],

  // AUTH_CACHE (`pool-buzzkit-auth-cache`): resolved dashboard sessions (5 min) and API keys
  // (60s, purged on revoke).
  // PROVIDER_CACHE (`pool-buzzkit-provider-cache`): short-lived provider tokens (APNs JWT).
  // ENGINE_DEFS (`pool-buzzkit-engine-definitions`): each tenant's published workflow
  // definitions and their version, read by the subscriber actors.
  "kv_namespaces": [
    {
      "binding": "AUTH_CACHE",
      "id": "7859feafbae145c3b3570fc848a4f88b"
    },
    {
      "binding": "PROVIDER_CACHE",
      "id": "90ea2cb4c51a46a2b647e8d6778039c8"
    },
    {
      "binding": "ENGINE_DEFS",
      "id": "4cc0839708114dbc8ed0e887c815661e"
    }
  ],

  "queues": {
    "producers": [
      { "queue": "pool-buzzkit-deliveries", "binding": "DELIVERIES" },
      { "queue": "pool-buzzkit-events", "binding": "EVENTS" },
      { "queue": "pool-buzzkit-webhooks", "binding": "WEBHOOKS" }
    ],
    "consumers": [
      {
        "queue": "pool-buzzkit-deliveries",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        "max_concurrency": 40,
        "max_retries": 8,
        "dead_letter_queue": "pool-buzzkit-deliveries-dlq"
      },
      {
        "queue": "pool-buzzkit-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_concurrency": 20,
        "max_retries": 10,
        "dead_letter_queue": "pool-buzzkit-events-dlq"
      },
      {
        "queue": "pool-buzzkit-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 100,
        "dead_letter_queue": "pool-buzzkit-events"
      },
      {
        "queue": "pool-buzzkit-webhooks",
        "max_batch_size": 20,
        "max_batch_timeout": 2,
        "max_concurrency": 20,
        "max_retries": 5,
        "dead_letter_queue": "pool-buzzkit-webhooks-dlq"
      },
      {
        "queue": "pool-buzzkit-deliveries-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3
      },
      {
        "queue": "pool-buzzkit-webhooks-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3
      }
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "SUBSCRIBER_ACTOR", "class_name": "SubscriberActor" }]
  },

  "workflows": [{ "name": "pool-buzzkit-workflows", "binding": "ENGINE", "class_name": "EngineWorkflow" }],

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SubscriberActor"] }],

  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *"]
  }
}
